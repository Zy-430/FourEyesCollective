/* ==================== SHARED FORM STYLES ==================== */
/* Form Styles */
.form-group {
    margin-bottom: 25px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: #2c3e50;
    font-size: 0.95em;
}

.form-control {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 15px;
    transition: all 0.3s ease;
    background: #f8f9fa;
}

.form-control:focus {
    outline: none;
    border-color: #2c3e50;
    background: white;
    box-shadow: 0 0 0 3px rgba(44, 62, 80, 0.1);
}

.form-control-phone {
    width: 90%;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 15px;
    transition: all 0.3s ease;
    background: #f8f9fa;
}

/* Alerts */
.alert {
    padding: 12px 16px;
    border-radius: 6px;
    margin-bottom: 20px;
    font-size: 14px;
}

.alert-error {
    background-color: #fde8e8;
    color: #c53030;
    border: 1px solid #feb2b2;
}

.alert-warning {
    background-color: #feebc8;
    color: #c05621;
    border: 1px solid #fbd38d;
}

.alert-message {
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 14px;
    line-height: 1.5;
}

.alert-success {
    background-color: #d1fae5;
    color: #065f46;
    border: 1px solid #a7f3d0;
}

.alert-info {
    background-color: #e8f4fd;
    color: #0c5460;
    border: 1px solid #bee5eb;
}

/* Error Messages */
.error-message {
    color: #e74c3c;
    font-size: 13px;
    margin-top: 5px;
    min-height: 20px;
}

/* Button Row */
.button-row {
    display: flex;
    gap: 15px;
    margin-top: 0px;
    margin-bottom: 20px;
}

.btn {
    padding: 14px 30px;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    flex: 1;
}

.btn-black {
    background: #2c3e50;
    color: white;
}

.btn-black:hover {
    background: #34495e;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(44, 62, 80, 0.2);
}

.btn-white {
    background: #ecf0f1;
    color: #2c3e50;
    border: 1px solid #ddd;
}

.btn-white:hover {
    background: #d5dbdb;
    transform: translateY(-2px);
}

.btn-success {
    background: #10b981;
    color: white;
}

.btn-success:hover {
    background: #0da271;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(16, 185, 129, 0.2);
}

.btn-block {
    flex: 1;
    width: 100%;
}

/* Links Container */
.links-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #eee;
}

.forgot-link {
    text-align: left;
}

.forgot-link a {
    color: #2c3e50;
    font-weight: 600;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s ease;
}

.forgot-link a:hover {
    color: #34495e;
    text-decoration: underline;
}

.back-link {
    text-align: right;
}

.back-link a {
    color: #7f8c8d;
    font-weight: 500;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s ease;
}

.back-link a:hover {
    color: #2c3e50;
    text-decoration: underline;
}

.signup-link {
    grid-column: 1 / -1;
    text-align: center;
    color: #7f8c8d;
    font-size: 15px;
    padding-top: 10px;
}

.signup-link a {
    color: #2c3e50;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease;
}

.signup-link a:hover {
    color: #34495e;
    text-decoration: underline;
}

/* Error Styling */
[class*="err-"] {
    color: #e74c3c;
    font-size: 10px;
    margin-top: 5px;
    display: block;
    min-height: 20px;
}

/* ==================== REGISTRATION-SPECIFIC STYLES ==================== */
/* Two-column layout for form */
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 10px;
}

.form-group.full-width {
    grid-column: 1 / -1;
}

/* Radio Group */
.radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 8px;
}

.radio-option {
    display: flex;
    align-items: center;
    gap: 8px;
}

.radio-option input[type="radio"] {
    width: 18px;
    height: 18px;
    margin: 0;
}

.radio-option label {
    margin-bottom: 0;
    font-weight: normal;
    cursor: pointer;
}

/* Date of Birth */
.dob-group {
    margin-top: 8px;
}

.dob-selectors {
    display: flex;
    gap: 15px;
}

.dob-select {
    flex: 1;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 15px;
    background: #f8f9fa;
    color: #333;
    cursor: pointer;
    transition: all 0.3s ease;
}

.dob-select:focus {
    outline: none;
    border-color: #2c3e50;
    background: white;
    box-shadow: 0 0 0 3px rgba(44, 62, 80, 0.1);
}

/* Photo Upload */
.photo-upload-container {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-top: 8px;
}

.photo-upload-label {
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
}

.photo-preview {
    width: 120px;
    height: 120px;
    border: 2px dashed #ddd;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: all 0.3s ease;
    background: #f8f9fa;
}

.photo-preview:hover {
    border-color: #2c3e50;
    background: #ecf0f1;
}

.photo-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.upload-button {
    color: #2c3e50;
    font-weight: 500;
    padding: 8px 20px;
    background: #f8f9fa;
    border-radius: 4px;
    transition: all 0.3s ease;
    border: 1px solid #ddd;
    cursor: pointer;
    font-size: 14px;
}

.upload-button:hover {
    background: #e9ecef;
    border-color: #2c3e50;
    transform: translateY(-1px);
}

.upload-instructions {
    color: #7f8c8d;
    font-size: 13px;
    line-height: 1.6;
    flex: 1;
}

.upload-instructions p {
    margin: 4px 0;
}

/* Registration Links Container */
body.registration-page .links-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
