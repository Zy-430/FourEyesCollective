/* ==================== RESPONSIVE DESIGN ==================== */
@media (max-width: 768px) {
    /* Common responsive styles */
    .header-content {
        flex-direction: column;
        gap: 20px;
        text-align: center;
    }
    
    .header-logo {
        width: 120px;
        height: 85px;
    }
    
    .login-container,
    .registration-container {
        margin: 10px;
        max-width: 90%;
    }
    
    body.login-page .login-form,
    body.registration-page .registration-form,
    body.forgot-password-page .login-form,
    body.reset-password-page .login-form {
        padding: 30px 25px;
    }
    
    body.login-page .login-header,
    body.registration-page .registration-header,
    body.forgot-password-page .login-header,
    body.reset-password-page .login-header {
        padding: 25px 20px;
    }
    
    body.login-page .login-header h1,
    body.registration-page .registration-header h1,
    body.forgot-password-page .login-header h1,
    body.reset-password-page .login-header h1 {
        font-size: 1.8em;
    }
    
    /* Registration specific responsive */
    .form-row {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    body.registration-page .photo-upload-container {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }
    
    body.registration-page .dob-selectors {
        flex-direction: column;
        gap: 10px;
    }
    
    /* Links container responsive */
    .links-container {
        grid-template-columns: 1fr;
        gap: 15px;
    }
    
    .back-link, .forgot-link {
        text-align: center;
    }
    
    /* Button row responsive */
    .button-row,
    body.forgot-password-page .form-actions {
        flex-direction: column;
    }
    
    /* Reset password responsive */
    body.reset-password-page .action-buttons {
        grid-template-columns: 1fr;
    }
}