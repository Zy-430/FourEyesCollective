/* ==================== COMMON STYLES ==================== */

/* Animation */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ==================== LOGIN PAGE STYLES ==================== */
body.login-page {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    padding: 15px;
    margin: 0;
}

body.login-page .login-container {
    width: 100%;
    max-width: 800px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    margin: 20px;
    animation: fadeIn 0.6s ease-out;
}

body.login-page .login-header {
    background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
    color: white;
    text-align: center;
    padding: 20px 30px;
    border-radius: 12px 12px 0 0;
}

/* Header with logo */
body.login-page .header-content {
    display: flex;
    align-items: center;
    gap: 30px;
    text-align: left;
    margin: 0 auto;
    justify-content: center;
}

body.login-page .logo-container {
    flex-shrink: 0;
}

body.login-page .header-logo {
    width: 140px;
    height: 100px;
    object-fit: contain;
    border-radius: 8px;
    padding: 5px;
    transition: transform 0.3s ease;
}

body.login-page .header-logo:hover {
    transform: scale(1.05);
}

body.login-page .header-text {
    flex: 1;
}

body.login-page .login-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2.2em;
    margin-bottom: 8px;
    color: white;
    font-weight: 600;
}

body.login-page .login-header p {
    font-size: 1.1em;
    opacity: 0.9;
    margin: 0;
}

body.login-page .login-form {
    padding: 40px;
}

